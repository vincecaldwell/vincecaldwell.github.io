---
/**
 * Inline SVG icons. Kept as a small hand-maintained map rather than an icon
 * library — the site needs eight glyphs, and inlining them costs no requests.
 *
 * Omit `title` for decorative icons (the default) and they are hidden from
 * assistive tech. Pass `title` only when the icon is the sole carrier of
 * meaning, e.g. a link with no visible label.
 */
export type IconName =
  | 'github'
  | 'linkedin'
  | 'mail'
  | 'rss'
  | 'sun'
  | 'moon'
  | 'arrow-right'
  | 'arrow-up-right'
  | 'download'
  | 'menu'
  | 'close';

interface Props {
  name: IconName;
  size?: number;
  title?: string;
  class?: string;
}

const { name, size = 20, title, class: className } = Astro.props;

// 24x24 viewBox paths. Stroke icons use currentColor + stroke; brand marks are filled.
const STROKE_ICONS: Partial<Record<IconName, string>> = {
  mail: '<path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="m3.5 7.5 8.5 6 8.5-6"/>',
  rss: '<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  moon: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8"/>',
  'arrow-right': '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7"/><path d="M8 7h9v9"/>',
  download: '<path d="M12 3v12"/><path d="m7 11 5 5 5-5"/><path d="M4 19h16"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
};

const FILL_ICONS: Partial<Record<IconName, string>> = {
  github:
    '<path d="M12 1.5a10.5 10.5 0 0 0-3.32 20.47c.53.1.72-.23.72-.5v-1.8c-2.92.63-3.54-1.4-3.54-1.4-.48-1.22-1.17-1.55-1.17-1.55-.96-.65.07-.64.07-.64 1.06.08 1.62 1.09 1.62 1.09.94 1.61 2.47 1.15 3.07.88.1-.68.37-1.15.67-1.41-2.33-.27-4.78-1.17-4.78-5.19 0-1.15.41-2.09 1.09-2.82-.11-.27-.47-1.34.1-2.79 0 0 .88-.28 2.89 1.08a10 10 0 0 1 5.26 0c2-1.36 2.88-1.08 2.88-1.08.58 1.45.21 2.52.11 2.79.68.73 1.09 1.67 1.09 2.82 0 4.03-2.46 4.92-4.8 5.18.38.33.71.97.71 1.96v2.9c0 .28.19.61.72.5A10.5 10.5 0 0 0 12 1.5"/>',
  linkedin:
    '<path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5M3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.75V21h-4v-5.6c0-1.34-.03-3.06-1.9-3.06-1.9 0-2.2 1.45-2.2 2.96V21H9z"/>',
};

const isFill = name in FILL_ICONS;
const path = isFill ? FILL_ICONS[name] : STROKE_ICONS[name];
const decorative = !title;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={isFill ? 'currentColor' : 'none'}
  stroke={isFill ? 'none' : 'currentColor'}
  stroke-width={isFill ? undefined : 1.75}
  stroke-linecap={isFill ? undefined : 'round'}
  stroke-linejoin={isFill ? undefined : 'round'}
  aria-hidden={decorative ? 'true' : undefined}
  role={decorative ? undefined : 'img'}
  focusable="false"
  class={className}
>
  {title && <title>{title}</title>}
  <Fragment set:html={path} />
</svg>

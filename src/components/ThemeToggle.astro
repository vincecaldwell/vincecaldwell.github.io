---
import Icon from './Icon.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class:list={[
    'inline-flex size-9 items-center justify-center rounded-lg border border-border-subtle text-muted transition-colors duration-200 hover:border-accent hover:text-accent',
    className,
  ]}
  aria-label="Toggle color theme"
  aria-pressed="false"
>
  {/* Both icons ship; CSS shows whichever matches the active theme. This avoids
      a swap flicker and keeps the button rendered before JS runs. */}
  <Icon name="sun" size={18} class="hidden dark:block" />
  <Icon name="moon" size={18} class="block dark:hidden" />
</button>

<script>
  const root = document.documentElement;

  const sync = () => {
    const isDark = root.dataset.theme === 'dark';
    document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(isDark));
    });
  };

  document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Non-persistent is better than broken.
      }
      sync();
    });
  });

  sync();
</script>

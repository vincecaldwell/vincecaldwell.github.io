---
interface Props {
  label: string;
  size?: 'sm' | 'md';
  as?: 'span' | 'li';
}

const { label, size = 'md', as: Tag = 'span' }: Props = Astro.props;

const sizes = {
  sm: 'px-2 py-0.5 text-2xs',
  md: 'px-2.5 py-1 text-xs',
};
---

<Tag
  class:list={[
    'inline-flex items-center rounded-md border border-border-subtle bg-bg-sunken font-mono text-muted',
    sizes[size],
  ]}
>
  {label}
</Tag>

---
import TechPill from './TechPill.astro';

interface Props {
  title: string;
  org: string;
  location?: string;
  start: string;
  end?: string | null;
  bullets?: string[];
  detail?: string;
  tags?: string[];
  /** Suppresses the left rail and tightens spacing for the print layout. */
  plain?: boolean;
}

const {
  title,
  org,
  location,
  start,
  end = null,
  bullets = [],
  detail,
  tags = [],
  plain = false,
}: Props = Astro.props;

// Education entries often carry only an end year, so guard against rendering a
// dangling "— 2020".
const period = start
  ? end
    ? `${start} — ${end}`
    : `${start} — Present`
  : (end ?? '');
---

<article
  class:list={[
    'relative',
    !plain &&
      'border-l border-border-subtle pl-6 before:absolute before:-left-[3px] before:top-2 before:size-[5px] before:rounded-full before:bg-accent',
  ]}
>
  <div
    class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
  >
    {/* The separator and its spaces live in one expression: Astro 7 compresses
        whitespace between inline elements, so spaces around a bare <span>
        would be stripped and the text would run together. */}
    <h3 class="font-semibold text-content">
      {title}
      <span class="font-normal text-muted">{` · ${org}`}</span>
    </h3>
    {
      period && (
        <p class="shrink-0 font-mono text-2xs uppercase tracking-widest text-faint">
          {period}
        </p>
      )
    }
  </div>

  {location && <p class="mt-1 text-sm text-faint">{location}</p>}

  {detail && <p class="mt-3 text-sm text-muted">{detail}</p>}

  {
    bullets.length > 0 && (
      <ul class="mt-3 flex flex-col gap-2">
        {bullets.map((bullet) => (
          <li class="relative pl-5 text-sm leading-relaxed text-muted before:absolute before:left-0 before:top-[0.6em] before:size-1 before:rounded-full before:bg-border-strong">
            {bullet}
          </li>
        ))}
      </ul>
    )
  }

  {
    tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <TechPill as="li" label={tag} size="sm" />
        ))}
      </ul>
    )
  }
</article>

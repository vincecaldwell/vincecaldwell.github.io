---
import PageLayout from '../../layouts/PageLayout.astro';
import TimelineEntry from '../../components/TimelineEntry.astro';
import SkillGroup from '../../components/SkillGroup.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import { getResume } from '../../utils/resume';
import { AUTHOR, RESUME_PDF_PATH } from '../../consts';

const resume = await getResume();
---

<PageLayout
  title="Resume"
  eyebrow="Experience"
  heading="Resume"
  description={`Resume of ${AUTHOR.name} — experience, skills and education.`}
>
  <div class="flex flex-col gap-16">
    <section aria-labelledby="summary-heading">
      <h2 id="summary-heading" class="sr-only">Summary</h2>
      <p class="max-w-prose text-lg leading-relaxed text-muted">
        {resume.summary}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        {/* The PDF is generated from /resume/print/ during the build, so it can
            never drift from what is on this page. */}
        <Button href={RESUME_PDF_PATH} download>
          Download PDF
          <Icon name="download" size={16} />
        </Button>
        <Button href={`mailto:${AUTHOR.email}`} variant="ghost">
          Email me
          <Icon name="mail" size={16} />
        </Button>
      </div>
    </section>

    <section aria-labelledby="experience-heading">
      <h2
        id="experience-heading"
        class="font-mono text-xs uppercase tracking-[0.2em] text-accent"
      >
        Experience
      </h2>

      <div class="mt-8 flex flex-col gap-10">
        {
          resume.experience.map((job) => (
            <TimelineEntry
              title={job.role}
              org={job.org}
              location={job.location}
              start={job.start}
              end={job.end}
              bullets={job.bullets}
              tags={job.tags}
            />
          ))
        }
      </div>
    </section>

    {
      resume.skills.length > 0 && (
        <section aria-labelledby="skills-heading">
          <h2
            id="skills-heading"
            class="font-mono text-xs uppercase tracking-[0.2em] text-accent"
          >
            Skills
          </h2>

          <div class="mt-8 flex flex-col gap-6">
            {resume.skills.map((group) => (
              <SkillGroup label={group.label} items={group.items} />
            ))}
          </div>
        </section>
      )
    }

    {
      resume.education.length > 0 && (
        <section aria-labelledby="education-heading">
          <h2
            id="education-heading"
            class="font-mono text-xs uppercase tracking-[0.2em] text-accent"
          >
            Education
          </h2>

          <div class="mt-8 flex flex-col gap-10">
            {resume.education.map((item) => (
              <TimelineEntry
                title={item.credential}
                org={item.org}
                location={item.location}
                start={item.start ?? ''}
                end={item.end}
                detail={item.detail}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      resume.certifications.length > 0 && (
        <section aria-labelledby="certifications-heading">
          <h2
            id="certifications-heading"
            class="font-mono text-xs uppercase tracking-[0.2em] text-accent"
          >
            Certifications
          </h2>

          <ul class="mt-8 flex flex-col gap-3">
            {resume.certifications.map((cert) => (
              <li class="flex flex-wrap items-baseline gap-x-3 text-sm">
                <span class="font-medium text-content">{cert.name}</span>
                <span class="text-muted">{cert.issuer}</span>
                {cert.year && (
                  <span class="font-mono text-2xs uppercase tracking-widest text-faint">
                    {cert.year}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</PageLayout>

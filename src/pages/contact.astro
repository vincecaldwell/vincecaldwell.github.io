---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';
import { AUTHOR, SOCIAL_LINKS } from '../consts';
---

<PageLayout
  title="Contact"
  eyebrow="Get in touch"
  heading="Contact"
  lede="The fastest way to reach me is email. I read everything and reply to anything that isn't a bulk pitch."
  description="Get in touch with Vince Caldwell — email, GitHub and LinkedIn."
  narrow
>
  {/* A mailto link rather than a form: this is a static site with no backend,
      and a form would mean handing a third-party service every message sent. */}
  <a
    href={`mailto:${AUTHOR.email}`}
    class="group flex items-center gap-4 rounded-xl border border-border-subtle bg-bg-raised p-6 transition-[border-color,transform] duration-300 hover:-translate-y-0.5 hover:border-accent/50"
  >
    <span
      class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-bg-sunken text-accent"
    >
      <Icon name="mail" size={20} />
    </span>
    <span class="min-w-0">
      <span class="block font-mono text-2xs uppercase tracking-widest text-faint">
        Email
      </span>
      <span
        class="mt-1 block break-all font-medium transition-colors group-hover:text-accent"
      >
        {AUTHOR.email}
      </span>
    </span>
  </a>

  <h2 class="mt-14 font-mono text-xs uppercase tracking-[0.2em] text-faint">
    Elsewhere
  </h2>

  <ul class="mt-5 flex flex-col gap-3">
    {
      SOCIAL_LINKS.filter((link) => link.href.startsWith('http')).map((link) => (
        <li>
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 rounded-xl border border-border-subtle p-5 transition-[border-color,transform] duration-300 hover:-translate-y-0.5 hover:border-accent/50"
          >
            <span class="flex size-9 shrink-0 items-center justify-center text-muted transition-colors group-hover:text-accent">
              <Icon name={link.icon} size={20} />
            </span>
            <span class="flex-1 font-medium transition-colors group-hover:text-accent">
              {link.label}
            </span>
            <Icon
              name="arrow-up-right"
              size={16}
              class="text-faint transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
            />
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </li>
      ))
    }
  </ul>
</PageLayout>
